# FlexTrainer configuration. All variables are optional; copy to .env for docker compose.
TZ=Europe/Amsterdam
PUID=99
PGID=100

# Theme for the first account: daylight | sand | midnight | nord | forest
DEFAULT_THEME=midnight

# ChatGPT checks (can also be set in the app under Settings). Question text is sent to this API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Backups: weekly, keep the last N (also editable in Settings)
BACKUP_ENABLED=true
BACKUP_KEEP=7

# Behind a reverse proxy under a sub-path, e.g. /flextrainer (leave empty for the root)
BASE_URL=
# Set true when the app is served over HTTPS and the proxy does not send X-Forwarded-Proto
COOKIE_SECURE=false

# Allow the scraper to fetch private/LAN addresses (off by default for safety)
ALLOW_PRIVATE_SCRAPE=false
# Check GitHub for new releases on the About page
UPDATE_CHECK=true
LOG_LEVEL=INFO
